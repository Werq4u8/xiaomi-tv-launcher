<?xml version="1.0" encoding="utf-8"?>
<!-- Главный экран лаунчера — как на референсе -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:focusable="false">

    <!-- ===== ВЕРХНЯЯ ПАНЕЛЬ ===== -->

    <!-- Время (верхний левый) -->
    <TextView
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:textColor="#FFFFFF"
        android:textSize="52sp"
        android:letterSpacing="-0.02"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="48dp"
        android:layout_marginTop="32dp" />

    <!-- Приветствие (над временем) -->
    <TextView
        android:id="@+id/tv_greeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#AAFFFFFF"
        android:textSize="13sp"
        android:textAllCaps="true"
        android:letterSpacing="0.12"
        app:layout_constraintBottom_toTopOf="@id/tv_time"
        app:layout_constraintStart_toStartOf="@id/tv_time"
        android:layout_marginBottom="2dp" />

    <!-- Дата (справа от времени, выравниваем по нижнему краю) -->
    <TextView
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#AAFFFFFF"
        android:textSize="14sp"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        app:layout_constraintBottom_toBottomOf="@id/tv_time"
        app:layout_constraintStart_toEndOf="@id/tv_time"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp" />

    <!-- Кнопки верхнего правого угла -->
    <LinearLayout
        android:id="@+id/top_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="48dp"
        android:layout_marginTop="36dp">

        <!-- Кнопка Input -->
        <LinearLayout
            android:id="@+id/btn_input"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill_button"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:focusable="true"
            android:clickable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏎  Inputs"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Wi-Fi кнопка -->
        <LinearLayout
            android:id="@+id/btn_wifi"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill_button"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginStart="8dp"
            android:focusable="true"
            android:clickable="true">
            <TextView
                android:id="@+id/tv_wifi_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▲  Wi-Fi"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Настройки -->
        <LinearLayout
            android:id="@+id/btn_settings"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill_button"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginStart="8dp"
            android:focusable="true"
            android:clickable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙  Settings"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- ===== ЦЕНТРАЛЬНАЯ ЧАСТЬ ===== -->

    <!-- Большое название выбранного приложения -->
    <TextView
        android:id="@+id/tv_featured_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/rv_apps"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="16dp" />

    <!-- ===== СТРОКА ПРИЛОЖЕНИЙ ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_apps"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:descendantFocusability="afterDescendants"
        android:clipToPadding="false"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/rv_all_apps"
        android:layout_marginBottom="16dp" />

    <!-- ===== СТРОКА ВСЕХ ПРИЛОЖЕНИЙ (снизу) ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_all_apps"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:descendantFocusability="afterDescendants"
        android:clipToPadding="false"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="32dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
